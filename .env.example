# Copy to .env.local and fill in. Never commit real values.
# NEVER prefix a secret with NEXT_PUBLIC_ — those values are inlined into the
# browser bundle and visible to every visitor.

# Postgres (Neon). Leave unset locally to use the built-in PGlite database
# (stored in .pglite/, migrated on server start). Required on Vercel.
DATABASE_URL=""

# Canonical public origin, no trailing slash (defaults to https://studywithbro.com).
NEXT_PUBLIC_SITE_URL="https://studywithbro.com"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the app, e.g. https://studywithbro.com (auto-detected locally)
BETTER_AUTH_URL=""

# Google sign-in (optional; the button only shows when both are set).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign-in codes by email (Resend). Without a key, local servers print the code to the console.
RESEND_API_KEY=""
EMAIL_FROM="Study Bro <no-reply@studywithbro.com>"

# Google Analytics (optional, public). Either a GA4 measurement id (G-XXXXXXXXXX, loaded with gtag.js)
# or a Tag Manager container (GTM-XXXXXXX). Anything else is ignored and tracking stays off.
NEXT_PUBLIC_GA_ID=""

# Feature flags (public, build-time). When OFF: hidden from navigation, pages 404.
NEXT_PUBLIC_FEATURE_HISTORY="true"
