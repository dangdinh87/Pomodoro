# Copy to .env.local and fill in. Never commit real values.
# NEVER prefix a secret with NEXT_PUBLIC_: those values are inlined into the
# browser bundle and visible to every visitor.
# Nothing below is required to run locally: with every value empty the app uses a
# built-in database and prints sign-in codes to the console.

# ── Database ──────────────────────────────────────────────────────────────────

# Postgres (Neon). Leave unset locally to use the built-in PGlite database
# (stored in .pglite/, migrated on server start). Required on Vercel (pooled URL).
# GitHub Actions needs its own DATABASE_URL secret with the UNPOOLED URL, for
# .github/workflows/db-migrate.yml. Read by: src/db/index.ts, drizzle.config.ts.
DATABASE_URL=""

# ── Site ──────────────────────────────────────────────────────────────────────

# Canonical public origin, no trailing slash (defaults to https://studywithbro.com).
# Used for canonical links, sitemap, Open Graph and the email sender default.
NEXT_PUBLIC_SITE_URL="https://studywithbro.com"

# Domain move: 1 makes the old domain and www.<new> answer 308 to the canonical
# origin. Leave unset until the new domain serves this project, otherwise visitors
# of the old domain are sent to an address that does not resolve. Read by: next.config.ts.
DOMAIN_MOVE=""

# ── Auth (Better Auth) ────────────────────────────────────────────────────────

# Session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the app, e.g. https://studywithbro.com (auto-detected locally).
BETTER_AUTH_URL=""

# Google sign-in (optional; the button only shows when both are set).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email (Resend) ────────────────────────────────────────────────────────────

# Sends the sign-in codes. Required on Vercel; without a key, local servers print the code to the console.
RESEND_API_KEY=""
# Sender; its domain must be verified in Resend.
EMAIL_FROM="Study Bro <no-reply@studywithbro.com>"

# ── Monitoring ────────────────────────────────────────────────────────────────

# Sentry error tracking (optional, server-only). Without it errors are still written
# to the runtime logs as one JSON line each. Read by: src/lib/observability.
SENTRY_DSN=""

# Google Analytics (optional, public). Either a GA4 measurement id (G-XXXXXXXXXX, loaded with gtag.js)
# or a Tag Manager container (GTM-XXXXXXX). Anything else is ignored and tracking stays off.
NEXT_PUBLIC_GA_ID=""

# ── Feature flags (public, build-time) ────────────────────────────────────────

# "false" hides the history and stats feature in the UI (default on). Read by: src/config/feature-flags.ts.
NEXT_PUBLIC_FEATURE_HISTORY="true"

# ── Set by the platform, do not define ────────────────────────────────────────
# VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA (Vercel; enforce DATABASE_URL, tag error reports),
# CI (GitHub Actions; makes drizzle.config.ts require DATABASE_URL), NODE_ENV and NEXT_RUNTIME (Next.js).
