# Copy to .env.local and fill in. Never commit real values.
# NEVER prefix a secret with NEXT_PUBLIC_ — those values are inlined into the
# browser bundle and visible to every visitor.

# Supabase (Project Settings → API). The anon key is public by design;
# data access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Google Analytics measurement id (optional, public)
NEXT_PUBLIC_GA_ID=""

# Feature flags (public, build-time). leaderboard default OFF, history ON.
# When OFF: hidden from navigation, pages 404, APIs return 404.
NEXT_PUBLIC_FEATURE_LEADERBOARD="false"
NEXT_PUBLIC_FEATURE_HISTORY="true"

# Supabase service-role key: server-only, required for account deletion
# (DELETE /api/account). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
